POSTGRES_DB=notecanva
POSTGRES_USER=notecanva
POSTGRES_PASSWORD=change_me_db_password

DATABASE_URL=postgres://notecanva:change_me_db_password@localhost:5432/notecanva
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_REALTIME_URL=redis://redis-realtime:6379
REDIS_JOBS_URL=redis://redis-jobs:6379
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,https://notebortt.web.app,https://note-canva.web.app

API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://api.example.com/auth/callback

JWT_SECRET=replace_with_long_random_secret_min_16_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

ENABLE_INCREMENTAL_PERSISTENCE=true
ENABLE_TARGETED_MUTATION_READS=true
PRESENCE_WRITE_THROTTLE_MS=3000
PRESENCE_WRITE_JITTER_MS=400
ENABLE_CLEANUP_ACTIVE_INDEX=true

# Background job intervals (BullMQ repeatable schedules)
#BOARD_PERSIST_INTERVAL_MS=30000
#REDIS_CLEANUP_INTERVAL_MS=120000

# Event transport: "local" = in-process (single process), "stream" =
# Redis Stream bus required when api/realtime/worker run as separate apps
#EVENT_BUS_MODE=local

# Disables the global + auth rate limiters. For load tests/benchmarks only —
# never set in production.
#RATE_LIMIT_DISABLED=false

# Ports
#PORT=3000
#REALTIME_PORT=3001
#METRICS_PORT=3002

# Bull Board dashboard at /admin/queues (defaults: on in dev, off in production)
#ENABLE_BULL_BOARD=true
# Credentials for the Bull Board dashboard (required in production)
#BULL_BOARD_USERNAME=admin
#BULL_BOARD_PASSWORD=change-me-please

# Serve the API under /api/v1 only (legacy unversioned paths stay on until flipped)
#ENABLE_LEGACY_API_ROUTES=false

STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_STARTUP=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_CHECKOUT_SUCCESS_URL=https://notebortt.web.app/profile/billing
STRIPE_CHECKOUT_CANCEL_URL=https://notebortt.web.app/profile/billing
STRIPE_PORTAL_RETURN_URL=https://notebortt.web.app/profile/billing
STRIPE_WEBHOOK_SECRET=whsec_xxx
