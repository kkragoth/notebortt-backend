# Copy this file and create Kubernetes secret from it:
# kubectl create secret generic backend-secrets --namespace=prod --from-env-file=./k8s/prod/backend-secrets.env

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://api.note-canva.com/auth/callback
JWT_SECRET=replace_with_long_random_secret_min_16_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_STARTUP=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_CHECKOUT_SUCCESS_URL=https://note-canva.web.app/profile/billing
STRIPE_CHECKOUT_CANCEL_URL=https://note-canva.web.app/profile/billing
STRIPE_PORTAL_RETURN_URL=https://note-canva.web.app/profile/billing
STRIPE_WEBHOOK_SECRET=whsec_xxx
