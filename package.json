{
  "name": "note-canva-backend",
  "version": "1.0.0",
  "description": "note-canva backend API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/apps/api.main.ts",
    "dev:realtime": "tsx watch src/apps/realtime.main.ts",
    "dev:worker": "tsx watch src/apps/worker.main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "tsc && tsc-alias",
    "start": "node dist/apps/api.main.js",
    "start:realtime": "node dist/apps/realtime.main.js",
    "start:worker": "node dist/apps/worker.main.js",
    "test": "vitest run",
    "test:socketio": "vitest run test/socketio.server.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/platform/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
    "engines": {
        "node": ">=22"
    },
