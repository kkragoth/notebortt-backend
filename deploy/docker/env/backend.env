NODE_ENV=production
PORT=3000

DATABASE_URL=postgres://notecanva:change_me_db_password@postgres:5432/notecanva
REDIS_REALTIME_URL=redis://redis-realtime:6379
REDIS_JOBS_URL=redis://redis-jobs:6379

# Comma-separated origins allowed by backend CORS
CORS_ORIGIN=http://localhost:3000,https://note-canva.web.app

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=https://api.example.com/auth/callback

JWT_SECRET=replace_with_long_random_secret_min_16_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
