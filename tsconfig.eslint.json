{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*",
    "test/**/*",
    "scripts/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
